{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/akaitigo/atlas-interoperability-lab/schemas/composition.schema.json",
  "title":"Stage 2 Composition Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","id","stage","core_contract","axes","subjects","profiles","scenarios"],
  "properties":{
    "schema_version":{"const":1},
    "id":{"$ref":"#/$defs/id"},
    "stage":{"const":2},
    "core_contract":{"type":"object","additionalProperties":false,"required":["repository","commit","policy_version"],"properties":{"repository":{"const":"reference-atlas-core"},"commit":{"pattern":"^[a-f0-9]{40}$"},"policy_version":{"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"}}},
    "axes":{"type":"array","minItems":10,"maxItems":10,"uniqueItems":true,"items":{"enum":["communication","identity","data","messaging","deployment","observability","security-boundary","failure-propagation","recovery","compatibility"]}},
    "subjects":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["name","subject_id","version","release_manifest","release_digest","certificate_digest"],"properties":{"name":{"$ref":"#/$defs/id"},"subject_id":{"$ref":"#/$defs/id"},"version":{"pattern":"^v[0-9]+\\.[0-9]+\\.[0-9]+$"},"release_manifest":{"$ref":"#/$defs/path"},"release_digest":{"$ref":"#/$defs/digest"},"certificate_digest":{"$ref":"#/$defs/digest"}}}},
    "profiles":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["local","container","cloud-live"]}},
    "scenarios":{"type":"array","minItems":4,"uniqueItems":true,"items":{"$ref":"#/$defs/path"}}
  },
  "$defs":{"id":{"type":"string","pattern":"^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},"path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}
}
