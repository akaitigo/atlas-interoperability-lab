{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/atlas-interoperability-lab/schemas/runtime-binding-evidence.schema.json",
  "title": "Stage 2 Runtime Binding Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "core_commit", "composition_id", "composition_digest", "profile", "observed_at", "execution_started_at", "execution_completed_at", "platform", "executable", "subjects", "runtime_evidence", "binding_state", "gaps", "definitive_eligible", "verdict"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 3},
    "core_commit": {"const": "072d7ca77981f51754e824d70c6d4ecd55ea67e5"},
    "composition_id": {"const": "fixture-http-stage2-v1"},
    "composition_digest": {"$ref": "#/$defs/digest"},
    "profile": {"enum": ["local", "container"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "execution_started_at": {"type": "string", "format": "date-time"},
    "execution_completed_at": {"type": "string", "format": "date-time"},
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "os", "architecture", "go_version"],
      "properties": {
        "kind": {"enum": ["local-process", "docker-container"]},
        "os": {"type": "string", "minLength": 2},
        "architecture": {"type": "string", "minLength": 2},
        "go_version": {"type": "string", "minLength": 2},
        "container_runtime": {"type": "string", "pattern": "^docker/.+"}
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifact_digest", "runtime_binary_digest", "build_recipe", "binding_method"],
      "properties": {
        "source_artifact_digest": {"$ref": "#/$defs/digest"},
        "runtime_binary_digest": {"$ref": "#/$defs/digest"},
        "build_recipe": {"type": "string", "minLength": 3},
        "binding_method": {"const": "sealed-runner-reproducible-build-recipe"}
      }
    },
    "subjects": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/subject"}},
    "runtime_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "scenarios", "cleanup", "scenario_count", "execution_state", "cleanup_state"],
      "properties": {
        "summary": {"$ref": "#/$defs/artifact_lock"},
        "scenarios": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/artifact_lock"}},
        "cleanup": {"$ref": "#/$defs/artifact_lock"},
        "scenario_count": {"const": 5},
        "execution_state": {"const": "pass"},
        "cleanup_state": {"const": "pass"}
      }
    },
    "binding_state": {"const": "runtime-recipe-observed-with-explicit-gaps"},
    "gaps": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["process-executable-attestation-unavailable", "subject-v2-certificate-atomic-binding-unavailable"]},
      "allOf": [
        {"contains": {"const": "process-executable-attestation-unavailable"}},
        {"contains": {"const": "subject-v2-certificate-atomic-binding-unavailable"}}
      ]
    },
    "definitive_eligible": {"const": false},
    "verdict": {"const": "pass"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^evidence/preview/runtime-binding/(local|container)/"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subject_id", "version", "release_digest", "certificate_digest", "artifact_digest", "launch_driver"],
      "properties": {
        "name": {"enum": ["source", "sink"]},
        "subject_id": {"type": "string", "minLength": 3},
        "version": {"type": "string", "minLength": 1},
        "release_digest": {"$ref": "#/$defs/digest"},
        "certificate_digest": {"$ref": "#/$defs/digest"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "launch_driver": {"type": "string", "minLength": 2}
      }
    }
  }
}
