{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/atlas-interoperability-lab/schemas/composition-v2-preview.schema.json",
  "title": "Stage 2 Definitive Gate v2 Preview Composition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "stage", "core_contract", "completion_mode", "coverage_epoch", "depth_reference_lock", "subject_depth_parity", "integration_proofs", "subjects"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"$ref": "#/$defs/id"},
    "stage": {"const": 2},
    "core_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_commit", "policy_version", "status"],
      "properties": {
        "repository": {"const": "reference-atlas-core"},
        "base_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "policy_version": {"const": "2.0.0-draft.1"},
        "status": {"const": "draft"}
      }
    },
    "completion_mode": {"enum": ["bounded-complete", "subject-definitive"]},
    "coverage_epoch": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "depth_reference_lock": {"$ref": "#/$defs/artifact_lock"},
    "subject_depth_parity": {"$ref": "#/$defs/artifact_lock"},
    "integration_proofs": {"$ref": "#/$defs/artifact_lock"},
    "subjects": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "subject_id", "version", "certificate", "certificate_digest"],
        "properties": {
          "name": {"$ref": "#/$defs/id"},
          "subject_id": {"$ref": "#/$defs/id"},
          "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "certificate": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
          "certificate_digest": {"$ref": "#/$defs/digest"}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
