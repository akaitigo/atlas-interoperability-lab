{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/atlas-interoperability-lab/schemas/subject-certificate-v2-preview.schema.json",
  "title": "Subject Definitive Certificate v2 Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_id", "version", "status", "completion_class", "core_policy_version", "coverage_epoch", "coverage_states", "artifact_digest", "valid_from", "valid_until"],
  "properties": {
    "schema_version": {"const": 2},
    "subject_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["active", "revoked", "superseded"]},
    "completion_class": {"enum": ["bounded-complete", "subject-definitive"]},
    "core_policy_version": {"const": "2.0.0-draft.1"},
    "coverage_epoch": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "coverage_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["covered", "excluded", "infeasible", "partial"]}},
    "artifact_digest": {"$ref": "#/$defs/digest"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "supersedes_digest": {"$ref": "#/$defs/digest"},
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revoked_at", "reason"],
      "properties": {"revoked_at": {"type": "string", "format": "date-time"}, "reason": {"$ref": "#/$defs/id"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "revoked"}}}, "then": {"required": ["revocation"]}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
