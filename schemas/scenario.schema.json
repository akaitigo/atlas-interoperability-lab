{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/akaitigo/atlas-interoperability-lab/schemas/scenario.schema.json",
  "title":"Interoperability Scenario",
  "type":"object","additionalProperties":false,
  "required":["schema_version","id","title","axes","oracle","phases"],
  "properties":{
    "schema_version":{"const":1},"id":{"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"title":{"type":"string","minLength":3},
    "axes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"oracle":{"type":"string","pattern":"^oracles/"},
    "phases":{"type":"object","additionalProperties":false,"required":["setup","execute","verify","cleanup"],"properties":{"setup":{"$ref":"#/$defs/actions"},"execute":{"$ref":"#/$defs/actions"},"verify":{"$ref":"#/$defs/actions"},"cleanup":{"$ref":"#/$defs/actions"}}}
  },
  "$defs":{"actions":{"type":"array","items":{"type":"object","required":["id","type"],"properties":{"id":{"type":"string"},"type":{"enum":["http","compare"]},"service":{"type":"string"},"method":{"enum":["GET","POST"]},"path":{"type":"string"},"headers":{"type":"object"},"body":{},"expect":{"type":"object"},"capture":{"type":"object"},"left":{"type":"string"},"right":{"type":"string"},"op":{"enum":["eq","ne","gte"]}}}}}
}
