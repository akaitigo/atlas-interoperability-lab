{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/atlas-interoperability-lab/schemas/subject-depth-parity.schema.json",
  "title": "Composition Subject Depth Parity",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "reference_id", "reference_commit", "reference_digest", "subjects"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type":"string","minLength":1},
    "reference_id": {"const":"fe-depth-reference-v1"},
    "reference_commit": {"const":"4a0b2df8e2091a963bd0e0e1bbccef9c84b49a45"},
    "reference_digest": {"const":"sha256:2452696f9807b7d4a8ffb22b3ba37f079a25a34ac2370d78423445b96064582a"},
    "subjects": {"type":"array","minItems":2,"uniqueItems":true,"items":{"$ref":"#/$defs/subject"}}
  },
  "$defs": {
    "digest": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "summary": {"type":"object","additionalProperties":false,"required":["satisfied","partial","missing"],"properties":{"satisfied":{"type":"integer","minimum":0},"partial":{"type":"integer","minimum":0},"missing":{"type":"integer","minimum":0}}},
    "proof": {"type":"object","additionalProperties":false,"required":["id","path","digest"],"properties":{"id":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"digest":{"$ref":"#/$defs/digest"}}},
    "axis": {"type":"object","additionalProperties":false,"required":["id","status","proofs"],"properties":{"id":{"type":"string","minLength":1},"status":{"enum":["satisfied","partial","missing"]},"proofs":{"type":"array","items":{"$ref":"#/$defs/proof"}}}},
    "subject": {"type":"object","additionalProperties":false,"required":["subject_id","status","summary","axes"],"properties":{"subject_id":{"type":"string","minLength":1},"status":{"enum":["complete","incomplete"]},"summary":{"$ref":"#/$defs/summary"},"axes":{"type":"array","minItems":18,"maxItems":18,"items":{"$ref":"#/$defs/axis"}}}}
  }
}
