{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/atlas-interoperability-lab/schemas/subject-binding-admission.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "core_commit", "policy", "verification_boundary", "candidates", "completion_state", "gaps", "definitive_eligible"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"const": "actual-subject-binding-candidates-v1"},
    "core_commit": {"const": "072d7ca77981f51754e824d70c6d4ecd55ea67e5"},
    "policy": {"const": "per-subject-no-aggregation"},
    "verification_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_git_object_verification", "public_ci_verification", "local_gate_required", "completion_effect"],
      "properties": {
        "local_git_object_verification": {"const": "required"},
        "public_ci_verification": {"const": "owner-signed-tracked-input"},
        "local_gate_required": {"const": true},
        "completion_effect": {"const": "none"}
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_id", "repository", "commit", "certificate", "requirements", "admission_state", "rejection_reasons"],
        "properties": {
          "subject_id": {"type": "string", "minLength": 3},
          "repository": {"type": "string", "pattern": "^https://github\\.com/[a-z0-9-]+/[a-z0-9-]+$"},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "certificate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest", "schema_version", "core_policy_version", "release", "subject_commit", "signature_kind"],
            "properties": {
              "path": {"const": "evidence/completion-certificate.json"},
              "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "schema_version": {"const": 1},
              "core_policy_version": {"type": "string"},
              "release": {"type": "string"},
              "subject_commit": {"type": "string"},
              "signature_kind": {"enum": ["none", "payload-sha256"]}
            }
          },
          "requirements": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixed_release_digest", "v2_certificate", "certificate_commit_atomic", "cryptographic_signature_verified", "depth_complete", "surface_pattern_complete", "authority_atomic_binding"],
            "properties": {
              "fixed_release_digest": {"const": false},
              "v2_certificate": {"const": false},
              "certificate_commit_atomic": {"const": false},
              "cryptographic_signature_verified": {"const": false},
              "depth_complete": {"const": false},
              "surface_pattern_complete": {"const": false},
              "authority_atomic_binding": {"const": false}
            }
          },
          "admission_state": {"const": "rejected"},
          "rejection_reasons": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
        }
      }
    },
    "completion_state": {"const": "incomplete"},
    "gaps": {"const": ["subject-v2-certificate-atomic-binding-unavailable"]},
    "definitive_eligible": {"const": false}
  }
}
