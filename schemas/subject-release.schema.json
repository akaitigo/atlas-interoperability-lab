{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/akaitigo/atlas-interoperability-lab/schemas/subject-release.schema.json",
  "title":"Completed Subject Release Interface",
  "type":"object","additionalProperties":false,
  "required":["schema_version","subject_id","version","status","artifact","launch","interfaces","certificate"],
  "properties":{
    "schema_version":{"const":1},"subject_id":{"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"version":{"pattern":"^v[0-9]+\\.[0-9]+\\.[0-9]+$"},"status":{"enum":["complete","incomplete"]},
    "artifact":{"type":"object","additionalProperties":false,"required":["path","digest","media_type"],"properties":{"path":{"type":"string","minLength":1},"digest":{"pattern":"^sha256:[a-f0-9]{64}$"},"media_type":{"type":"string","minLength":3}}},
    "launch":{"type":"object","additionalProperties":false,"required":["driver","args","port"],"properties":{"driver":{"const":"go-source"},"args":{"type":"array","items":{"type":"string"}},"port":{"type":"integer","minimum":1,"maximum":65535}}},
    "interfaces":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"certificate":{"type":"string","minLength":1}
  }
}
