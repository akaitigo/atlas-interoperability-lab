{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akaitigo/atlas-interoperability-lab/schemas/composition-evidence-dependency.schema.json",
  "title": "Composition Evidence Dependency Graph Preview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "atlas_id", "core_commit", "generated_at", "status", "policy", "inputs", "outputs", "runs", "required_outputs", "structures", "completion_state", "gaps", "definitive_eligible"],
  "properties": {
    "schema_version": {"const": 1},
    "atlas_id": {"const": "atlas-interoperability-lab"},
    "core_commit": {"const": "072d7ca77981f51754e824d70c6d4ecd55ea67e5"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["current", "stale"]},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["transitive_staleness", "digest_only_closure_forbidden", "actual_rerun_required", "missing_rerun_targets_fail", "proof_structure_invariant", "closure_plan_structure_invariant"],
      "properties": {
        "transitive_staleness": {"const": true},
        "digest_only_closure_forbidden": {"const": true},
        "actual_rerun_required": {"const": true},
        "missing_rerun_targets_fail": {"const": true},
        "proof_structure_invariant": {"const": true},
        "closure_plan_structure_invariant": {"const": true}
      }
    },
    "inputs": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "minItems": 19, "items": {"$ref": "#/$defs/output"}},
    "runs": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/run"}},
    "required_outputs": {"type": "array", "minItems": 19, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "structures": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/structure"}},
    "completion_state": {"const": "incomplete"},
    "gaps": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": ["process-executable-attestation-unavailable", "subject-depth-parity-incomplete", "subject-v2-certificate-atomic-binding-unavailable", "surface-pattern-proof-gaps"]}
    },
    "definitive_eligible": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "members", "baseline_digest", "current_digest", "observed_at"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["contract", "source", "harness", "runtime", "profile"]},
        "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline_digest": {"$ref": "#/$defs/digest"},
        "current_digest": {"$ref": "#/$defs/digest"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "path", "digest", "depends_on", "status", "run_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["runtime-evidence", "compatibility", "scenario-proof", "closure-plan"]},
        "path": {"type": "string", "minLength": 3},
        "digest": {"$ref": "#/$defs/digest"},
        "depends_on": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "status": {"enum": ["current", "stale"]},
        "run_id": {"$ref": "#/$defs/id"}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["input_id", "digest"],
      "properties": {"input_id": {"$ref": "#/$defs/id"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "execution_kind", "command", "started_at", "completed_at", "result", "attempts", "input_bindings", "output_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "execution_kind": {"enum": ["runtime", "derived"]},
        "command": {"type": "string", "minLength": 3},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "result": {"const": "passed"},
        "attempts": {"const": 1},
        "runtime_identity": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "input_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
        "output_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "structure": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "path", "baseline_digest"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["scenario-proof-index", "scenario-closure-plan"]},
        "path": {"type": "string", "minLength": 3},
        "baseline_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
