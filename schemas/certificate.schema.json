{
  "$schema":"https://json-schema.org/draft/2020-12/schema","title":"Core v1 Stage 2 Completion Certificate","type":"object","additionalProperties":false,
  "required":["schema_version","atlas_id","atlas_release","coverage_epoch","authority_lock_digest","core_policy_version","required_profiles","graph_digest","evidence_set_digest","skill_package_digest","skill_eval","sbom_digest","provenance_digest","issued_at","commit","signature"],
  "properties":{
    "schema_version":{"const":1},"atlas_id":{"const":"atlas-interoperability-lab"},"atlas_release":{"pattern":"^v[0-9]+\\.[0-9]+\\.[0-9]+$"},"coverage_epoch":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},"authority_lock_digest":{"$ref":"#/$defs/digest"},"core_policy_version":{"pattern":"^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"},
    "required_profiles":{"type":"array","minItems":2,"items":{"type":"object","required":["profile","result","evidence_ids"],"properties":{"profile":{"enum":["local","container"]},"result":{"const":"pass"},"evidence_ids":{"type":"array","minItems":1}}}},
    "graph_digest":{"$ref":"#/$defs/digest"},"evidence_set_digest":{"$ref":"#/$defs/digest"},"skill_package_digest":{"$ref":"#/$defs/digest"},"skill_eval":{"type":"object","required":["digest","pass_rate"]},"sbom_digest":{"$ref":"#/$defs/digest"},"provenance_digest":{"$ref":"#/$defs/digest"},"issued_at":{"type":"string","format":"date-time"},"commit":{"pattern":"^[a-f0-9]{40}$"},"signature":{"type":"object","required":["type","digest"],"properties":{"type":{"const":"payload-sha256"},"digest":{"$ref":"#/$defs/digest"}}}
  },
  "$defs":{"digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}
}
